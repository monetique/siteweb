# Adresse de l'API Strapi utilisée pendant la génération du site (réseau interne)
STRAPI_URL=http://localhost:1337
# Jeton d'API Strapi en lecture seule (facultatif si l'API publique est ouverte en lecture)
STRAPI_TOKEN=
# Adresse publique des médias (images, PDF). Par défaut = STRAPI_URL
MEDIA_BASE_URL=
# Adresse publique du site (balises canoniques, plan du site)
SITE_URL=https://www.monetiquetunisie.com
# Adresse du dépôt des messages (production : /api/messages-contact, proxifiée par Nginx vers Strapi)
NEXT_PUBLIC_CONTACT_ENDPOINT=/api/messages-contact
