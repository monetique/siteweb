# CMS lu pendant la génération du site : drupal (par défaut) ou strapi (ancien CMS, transition)
CMS_BACKEND=drupal
# Adresse de l'API Drupal (JSON:API) utilisée pendant la génération du site (réseau interne)
DRUPAL_URL=http://127.0.0.1:8080
# Ancien CMS Strapi (seulement si CMS_BACKEND=strapi)
STRAPI_URL=http://localhost:1337
# Jeton d'API Strapi en lecture seule (facultatif si l'API publique est ouverte en lecture)
STRAPI_TOKEN=
# Adresse publique des médias (images, PDF). Par défaut = DRUPAL_URL
MEDIA_BASE_URL=
# Adresse publique du site (balises canoniques, plan du site)
SITE_URL=https://www.monetiquetunisie.com
# Adresse du dépôt des messages (production : /api/messages-contact, proxifiée par Nginx vers Drupal)
NEXT_PUBLIC_CONTACT_ENDPOINT=/api/messages-contact
