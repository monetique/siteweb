# Production : 127.0.0.1 (ou réseau Docker interne). Strapi ne doit JAMAIS être joignable directement depuis Internet.
HOST=127.0.0.1
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Base de données (production : postgres)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=smt_cms
# DATABASE_USERNAME=smt
# DATABASE_PASSWORD=

STRAPI_TELEMETRY_DISABLED=true

# Sécurité
CORS_ORIGINS=https://www.monetiquetunisie.com,https://admin.monetiquetunisie.local
IS_PROXIED=true

# --- E-mails du formulaire de contact (étape 5) ---------------------------------
# Développement : simulateur local (python3 scripts/smtp-simulateur.py) sur 127.0.0.1:1025
# Production : serveur SMTP de SMT (ex. port 587 + SMTP_REQUIRE_TLS=true + identifiants)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Monétique Tunisie <no-reply@monetiquetunisie.com>"
SMTP_REPLY_TO=contact@monetiquetunisie.com
CONTACT_NOTIFY_TO=contact@monetiquetunisie.com
# Routage par objet (facultatif), JSON sur une ligne :
CONTACT_ROUTING={"ecommerce_clictopay":"direction.commerciale@monetiquetunisie.com","reclamation_autre":"reclamations@monetiquetunisie.com"}
CONTACT_ACK_ENABLED=true
ADMIN_PUBLIC_URL=https://admin.monetiquetunisie.local

# --- Reconstruction automatique du site (étape 5) -------------------------------
# Service deploy/builder (127.0.0.1:4000). Même secret des deux côtés : openssl rand -hex 24
REBUILD_WEBHOOK_URL=http://127.0.0.1:4000/rebuild
REBUILD_WEBHOOK_SECRET=
