# Copier en builder.env (droits 600, propriétaire smt-web)
REBUILD_WEBHOOK_SECRET=        # identique à SMT_REBUILD_SECRET côté Drupal (openssl rand -hex 24)
BUILDER_PORT=4000
WEB_DIR=/opt/smt/smt-web
SITE_ROOT=/var/www/smt         # Nginx sert /var/www/smt/current
DEBOUNCE_MS=20000              # regroupe les publications rapprochées (20 s)
KEEP_RELEASES=5                # versions conservées pour retour arrière
MIN_PAGES=20                   # en dessous, la mise en ligne est bloquée
BUILD_TIMEOUT_MS=300000
# Variables lues par le build Next.js
CMS_BACKEND=drupal
DRUPAL_URL=http://127.0.0.1:8080     # API Drupal (réseau interne)
# Ancien CMS (CMS_BACKEND=strapi) :
STRAPI_URL=http://127.0.0.1:1337
STRAPI_TOKEN=                  # jeton API Strapi en LECTURE SEULE
SITE_URL=https://www.monetiquetunisie.com
NEXT_PUBLIC_CONTACT_ENDPOINT=/api/messages-contact
